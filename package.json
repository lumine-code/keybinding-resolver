{
  "name": "keybinding-resolver",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show what commands a keybinding resolves to.",
  "keywords": [
    "keyboard",
    "shortcut",
    "dispatch",
    "conflict",
    "debug"
  ],
  "repository": "https://github.com/lumine-code/keybinding-resolver",
  "bugs": {
    "url": "https://github.com/lumine-code/keybinding-resolver/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "keybinding-resolver/KeyBindingResolverView": "deserializeKeyBindingResolverView"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#0ab829a5b2576c5d3c782df34eab9b34f9c2b4e0",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#30223414897c13c4cf75ba39f0d163590d84d7e2",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#152c989451922b109de6d2b8b9122ed9aa57f276"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
