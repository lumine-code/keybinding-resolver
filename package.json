{
  "name": "keybinding-resolver",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show what commands a keybinding resolves to.",
  "keywords": [
    "keyboard",
    "shortcut",
    "dispatch",
    "conflict",
    "debug"
  ],
  "repository": "https://github.com/lumine-code/keybinding-resolver",
  "bugs": {
    "url": "https://github.com/lumine-code/keybinding-resolver/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "keybinding-resolver/KeyBindingResolverView": "deserializeKeyBindingResolverView"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#3e56e2460d890ab9b85e4f1d6bef236d34230530",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#f9f057b92fb8f7b608ef80f25c429981b6cf0800",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#f2ad78026b74af82520aaa07397b611e35807c9f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
