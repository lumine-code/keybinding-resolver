{
  "name": "keybinding-resolver",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show what commands a keybinding resolves to.",
  "keywords": [
    "keyboard",
    "shortcut",
    "dispatch",
    "conflict",
    "debug"
  ],
  "repository": "https://github.com/lumine-code/keybinding-resolver",
  "bugs": {
    "url": "https://github.com/lumine-code/keybinding-resolver/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "keybinding-resolver/KeyBindingResolverView": "deserializeKeyBindingResolverView"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#c415f1685f7b913b137ffbd0b3e7fa983cb24f17",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#a78a80911e995d4ed3e002c259d1b4a8f54c838b",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#4eaf72f977aa93184026532974e562d5072c7005"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
